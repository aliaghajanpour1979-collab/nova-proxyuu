{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxyuu",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "79bbf73f-1a9f-4a90-9215-76401812d9c8","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "999e786933e94987922f2bb34e3a61e2" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
